{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfwtemplate",
  "account_id": "37534748af0ad176a603fd03acf642aa",
  "main": "./server/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "vars": {
    "AUTH_MODE": "access",
    "ADMIN_EMAILS": "curlfw@gmail.com,tanya.chen.youyou@gmail.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfwtemplate-db",
      "database_id": "dfab90bf-970f-42f8-a4d2-7d53e9aa710f",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
