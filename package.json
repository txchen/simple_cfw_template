{
  "name": "simple-cfw-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "vp exec vue-tsc --noEmit -p tsconfig.app.json && vp exec tsc --noEmit -p tsconfig.worker.json && vp exec tsc --noEmit -p tsconfig.node.json",
    "test": "vp test",
    "test:run": "vp test",
    "check": "vp check && vp run typecheck && vp test && vp build",
    "deploy": "vp run check && vp exec wrangler deploy",
    "db:migrate:local": "vp exec wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "vp exec wrangler d1 migrations apply DB --remote",
    "cf-typegen": "vp exec wrangler types"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.3.0",
    "hono": "^4.12.32",
    "valibot": "^1.4.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "packageManager": "npm@12.0.2"
}
